# Must run before project(): vcpkg installs its manifest during project().
option(KOMAMIMIC_WINDOWS_FAST "Use prebuilt Qt and Release-only non-Qt dependencies" OFF)
if(KOMAMIMIC_WINDOWS_FAST)
    if(NOT CMAKE_HOST_WIN32)
        message(FATAL_ERROR "KOMAMIMIC_WINDOWS_FAST requires native Windows")
    endif()
    set(KOMAMIMIC_QT_ROOT "$ENV{KOMAMIMIC_QT_ROOT}" CACHE PATH "Prebuilt MSVC Qt SDK root")
    file(READ "${CMAKE_CURRENT_LIST_DIR}/../tools/windows-fast.json" sdk_config)
    string(JSON KOMAMIMIC_QT_VERSION GET "${sdk_config}" qt_version)
    string(JSON sdk_file_count LENGTH "${sdk_config}" required_files)
    math(EXPR sdk_last "${sdk_file_count} - 1")
    foreach(index RANGE ${sdk_last})
        string(JSON file GET "${sdk_config}" required_files ${index})
        if(NOT EXISTS "${KOMAMIMIC_QT_ROOT}/${file}")
            message(FATAL_ERROR "Incomplete prebuilt Qt SDK: ${KOMAMIMIC_QT_ROOT}/${file}. Run tools/setup_windows.py; Qt will not be built from source.")
        endif()
    endforeach()
    set(VCPKG_MANIFEST_DIR "${CMAKE_CURRENT_LIST_DIR}/windows-fast" CACHE PATH "Non-Qt manifest" FORCE)
    set(VCPKG_OVERLAY_TRIPLETS "${CMAKE_CURRENT_LIST_DIR}/triplets" CACHE STRING "Release-only triplets" FORCE)
    set(VCPKG_TARGET_TRIPLET x64-windows-release CACHE STRING "Target" FORCE)
    set(VCPKG_HOST_TRIPLET x64-windows-release CACHE STRING "Host" FORCE)
    set(CMAKE_CONFIGURATION_TYPES Release CACHE STRING "Release runtime only" FORCE)
    set(Qt6_DIR "${KOMAMIMIC_QT_ROOT}/lib/cmake/Qt6" CACHE PATH "Use the matching prebuilt SDK" FORCE)
    list(PREPEND CMAKE_PREFIX_PATH "${KOMAMIMIC_QT_ROOT}")
endif()
