* text=auto
*.cpp text eol=lf
*.h text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.cmake text eol=lf
# Unified diff context keeps a prefix space on blank lines and before tabs.
cmake/ports/libarchive/*.patch text eol=lf whitespace=-space-before-tab,-blank-at-eol
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.desktop text eol=lf
*.qrc text eol=lf
*.in text eol=lf
*.png binary
*.ico binary
*.icns binary
